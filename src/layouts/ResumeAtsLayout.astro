---
import type { CollectionEntry } from "astro:content";

interface Props {
  resume: CollectionEntry<"resumes">["data"];
  slug: string;
}

const { resume, slug } = Astro.props;
const buildDate = new Date().toISOString().slice(0, 10);
const versionUrl = Astro.site
  ? new URL(`/resumes/${slug}/print/`, Astro.site).href
  : `/resumes/${slug}/print/`;

const stripProtocol = (value: string) =>
  value.replace(/^https?:\/\//i, "").replace(/\/$/g, "");

const contactItems = [
  resume.contact.email && {
    href: `mailto:${resume.contact.email}`,
    label: resume.contact.email,
  },
  resume.contact.phone && {
    href: `tel:${resume.contact.phone.replace(/[^+\d]/g, "")}`,
    label: resume.contact.phone,
  },
  resume.contact.website && {
    href: resume.contact.website.startsWith("http")
      ? resume.contact.website
      : `https://${resume.contact.website}`,
    label: stripProtocol(resume.contact.website),
  },
  resume.contact.linkedin && {
    href: `https://www.linkedin.com/in/${resume.contact.linkedin}/`,
    label: `linkedin.com/in/${resume.contact.linkedin}`,
  },
].filter(Boolean) as Array<{ href: string; label: string }>;
---

<div class="ats-page">
  <main class="ats-document" aria-label={`${resume.profile.name} ATS resume`}>
    <header class="ats-heading">
      <h1>{resume.profile.name}</h1>
      {resume.profile.location && <p>{resume.profile.location}</p>}
      {
        contactItems.length > 0 && (
          <p class="ats-contact">
            {contactItems.map((item, index) => (
              <>
                <a href={item.href}>{item.label}</a>
                {index < contactItems.length - 1 && <span> | </span>}
              </>
            ))}
          </p>
        )
      }
    </header>

    <section class="ats-section">
      <h2>Summary</h2>
      <p>{resume.careerProfile.summary}</p>
    </section>

    {
      resume.skills.length > 0 && (
        <section class="ats-section">
          <h2>Skills</h2>
          <div class="ats-skill-list">
            {resume.skills.map((skill) => (
              <p>
                <strong>{skill.title}:</strong> {skill.value}
              </p>
            ))}
          </div>
        </section>
      )
    }

    {
      resume.experiences.length > 0 && (
        <section class="ats-section">
          <h2>Professional Experience</h2>
          {resume.experiences.map((exp) => (
            <article class="ats-entry">
              <header>
                <h3>
                  {exp.role} | {exp.time}
                </h3>
                <p>
                  <strong>{exp.company}</strong>
                  {exp.location && <> | {exp.location}</>}
                </p>
              </header>
              {exp.summary && <p>{exp.summary}</p>}
              {exp.bullets && exp.bullets.length > 0 && (
                <ul>
                  {exp.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>
      )
    }

    {
      resume.projects && resume.projects.assignments.length > 0 && (
        <section class="ats-section">
          <h2>Selected Projects</h2>
          {resume.projects.intro && <p>{resume.projects.intro}</p>}
          {resume.projects.assignments.map((project) => (
            <article class="ats-entry">
              <h3>
                {project.link ? (
                  <a href={project.link}>{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              {project.tagline && <p>{project.tagline}</p>}
            </article>
          ))}
        </section>
      )
    }

    {
      resume.publications && resume.publications.papers.length > 0 && (
        <section class="ats-section">
          <h2>Publications</h2>
          {resume.publications.intro && <p>{resume.publications.intro}</p>}
          {resume.publications.papers.map((paper) => (
            <article class="ats-entry">
              <h3>{paper.title}</h3>
              <p>{paper.authors}</p>
              <p>{paper.conference}</p>
            </article>
          ))}
        </section>
      )
    }

    {
      resume.education && resume.education.length > 0 && (
        <section class="ats-section">
          <h2>Education</h2>
          {resume.education.map((edu) => (
            <article class="ats-entry">
              <h3>{edu.degree ?? edu.university}</h3>
              {edu.degree && <p>{edu.university}</p>}
              {edu.time && <p>{edu.time}</p>}
              {edu.details && <p>{edu.details}</p>}
            </article>
          ))}
        </section>
      )
    }

    {
      resume.languages && resume.languages.length > 0 && (
        <section class="ats-section">
          <h2>Languages</h2>
          <p>
            {resume.languages
              .map((language) => `${language.idiom}: ${language.level}`)
              .join("; ")}
          </p>
        </section>
      )
    }

    {
      resume.interests && resume.interests.length > 0 && (
        <section class="ats-section">
          <h2>Interests</h2>
          <p>{resume.interests.map((interest) => interest.item).join("; ")}</p>
        </section>
      )
    }

    <footer class="ats-generated">
      Generated {buildDate}. Current version: {versionUrl}
    </footer>
  </main>
</div>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    if (target.closest("[data-ats-print-button]")) {
      e.preventDefault();
      window.print();
    }
  });
</script>

<style is:global>
  .ats-page {
    min-height: 100vh;
    background: #f3f4f6;
    color: #111827;
    font-family: Arial, Calibri, sans-serif;
  }

  .ats-toolbar {
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
  }

  .ats-toolbar a,
  .ats-toolbar button {
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    background: #ffffff;
    color: #111827;
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.625rem 0.875rem;
    text-decoration: none;
  }

  .ats-toolbar a:hover,
  .ats-toolbar button:hover,
  .ats-toolbar a:focus-visible,
  .ats-toolbar button:focus-visible {
    border-color: #111827;
    outline: 2px solid transparent;
  }

  .ats-document {
    box-sizing: border-box;
    width: min(100%, 8.5in);
    margin: 0 auto 2rem;
    padding: 0.6in;
    background: #ffffff;
    box-shadow: 0 18px 45px rgb(15 23 42 / 0.12);
    font-size: 10.5pt;
    line-height: 1.42;
  }

  .ats-document h1,
  .ats-document h2,
  .ats-document h3,
  .ats-document p {
    margin: 0;
  }

  .ats-document a {
    color: inherit;
    text-decoration: none;
  }

  .ats-heading {
    margin-bottom: 0.28in;
  }

  .ats-heading h1 {
    font-size: 18pt;
    line-height: 1.1;
  }

  .ats-heading p {
    margin-top: 0.05in;
  }

  .ats-contact {
    overflow-wrap: anywhere;
  }

  .ats-section {
    margin-top: 0.22in;
  }

  .ats-section h2 {
    margin-bottom: 0.11in;
    border-bottom: 1px solid #111827;
    font-size: 11pt;
    letter-spacing: 0.02em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .ats-entry {
    break-inside: avoid;
    page-break-inside: avoid;
    margin-top: 0.14in;
  }

  .ats-entry:first-of-type {
    margin-top: 0;
  }

  .ats-entry h3 {
    font-size: 10.5pt;
    line-height: 1.35;
  }

  .ats-entry header p,
  .ats-entry > p {
    margin-top: 0.03in;
  }

  .ats-document ul {
    margin: 0.07in 0 0;
    padding-left: 0.22in;
  }

  .ats-document li {
    margin-top: 0.035in;
    padding-left: 0.02in;
  }

  .ats-skill-list p + p {
    margin-top: 0.06in;
  }

  .ats-generated {
    margin-top: 0.3in;
    border-top: 1px solid #d1d5db;
    padding-top: 0.08in;
    color: #4b5563;
    font-size: 8.5pt;
  }

  @media print {
    @page {
      size: letter;
      margin: 0.5in;
    }

    html,
    body,
    .ats-page {
      background: #ffffff !important;
      color: #000000 !important;
    }

    .ats-toolbar {
      display: none !important;
    }

    .ats-document {
      width: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
      font-size: 10pt;
    }

    .ats-document a {
      text-decoration: none;
    }
  }
</style>
